# ---------------------------------------------------------------------------
# Peaceful Cloud Console — environment sample
#
# Copy this file and adjust it:
#
#   cp .env.sample .env
#
# The console loads `.env` from its working directory automatically, unless
# CONSOLE_ENV_FILE points somewhere else. Real environment variables always win
# over values in the file, so `FOO=bar ./cloud-console` overrides `.env`.
#
# The file is also compatible with systemd EnvironmentFile= and with
# `set -a; source .env; set +a` in a shell, so all comments must stay on their
# own lines.
#
# Every value below matches the console's built-in default, except CONSOLE_ADDR,
# which is narrowed to loopback here so a fresh install is not exposed before
# it is configured. Deleting a line is the same as leaving it at the default.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Console (HTTP, storage, bootstrap)
# ---------------------------------------------------------------------------

# HTTP listen address. Bind to 127.0.0.1 when Caddy or another proxy is in
# front, so the console itself is never directly reachable.
CONSOLE_ADDR=127.0.0.1:8080

# Public URL of the console. Used to add the console's own site block to the
# generated Caddyfile, so it gets a certificate like every other domain.
CONSOLE_BASE_URL=http://localhost:8080

# Where the SQLite database and backup archives live.
CONSOLE_DATA_DIR=./data

# SQLite file. Defaults to CONSOLE_DATA_DIR/console.db when left empty.
# CONSOLE_DB_PATH=

# Set to true when the console is served over HTTPS. Cookies then carry the
# Secure flag. Leave false for plain HTTP on localhost.
CONSOLE_SECURE_COOKIES=false

# How long a sign-in lasts, in hours. Default 168 (7 days).
CONSOLE_SESSION_TTL_HOURS=168

# Informational ceiling shown in the UI. Not enforced.
CONSOLE_MAX_INSTANCES=100

# Bootstrap administrator, created only when the user table is empty.
# Leave CONSOLE_ADMIN_PASSWORD empty to have a random password generated and
# printed once at startup — recommended.
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=

# Path to an alternative .env file. Defaults to ./.env when unset.
# CONSOLE_ENV_FILE=/etc/peaceful-cloud/console.env

# Load templates and static files from disk instead of the embedded copies,
# so edits appear without rebuilding. Development only.
CONSOLE_DEV=false

# Log level is a flag, not a variable: ./cloud-console -log-level debug
# Accepted values: debug, info, warn, error.


# ---------------------------------------------------------------------------
# Incus
# ---------------------------------------------------------------------------

# Path to the Incus daemon's Unix socket. The console never exposes the Incus
# API to the network — it only talks over this socket.
INCUS_SOCKET=/var/lib/incus/unix.socket

# Incus project to operate in. Empty means the default project.
INCUS_PROJECT=


# ---------------------------------------------------------------------------
# Caddy (public web traffic and automatic HTTPS)
# ---------------------------------------------------------------------------

# Preferred way to apply domain changes: Caddy's admin API. The console POSTs
# the generated Caddyfile to <url>/load.
#
# Enable it in /etc/caddy/Caddyfile with:
#     { admin localhost:2019 }
#
# Left commented out on purpose: turning this on without a reachable admin API
# makes every domain change fail. Uncomment it once Caddy is ready.
# CADDY_ADMIN_URL=http://localhost:2019

# Alternative to the admin API: write the generated Caddyfile to this path.
# Useful when Caddy runs in a container or the admin API is disabled.
# If you set this, make sure your own Caddyfile imports it:
#     import /etc/caddy/cloud-console.caddy
# CADDY_CONFIG_PATH=/etc/caddy/cloud-console.caddy

# Command used to reload Caddy when CADDY_ADMIN_URL is not set.
# Defaults to: caddy reload --config <CADDY_CONFIG_PATH>
# CADDY_RELOAD_CMD=caddy reload --config /etc/caddy/cloud-console.caddy


# ---------------------------------------------------------------------------
# Backups (S3-compatible object storage)
# ---------------------------------------------------------------------------
#
# Optional, but strongly recommended: without it, backups live on the same
# server they are meant to protect. Works with AWS S3, MinIO, Backblaze B2,
# Wasabi, Cloudflare R2 and anything else speaking the S3 API.
#
# Leave S3_ENDPOINT empty to keep backups on local disk only.

# S3_ENDPOINT=s3.eu-west-1.amazonaws.com
# S3_BUCKET=incus-backups
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=eu-west-1
# S3_PREFIX=cloud-console
# S3_USE_SSL=true


# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------

# Seconds between metric samples. Minimum 10. Incus only reports live
# counters, so the console records the history itself.
CONSOLE_METRICS_INTERVAL=60

# How long metric samples are kept, in hours. Default 168 (7 days).
CONSOLE_METRICS_RETENTION_HOURS=168
